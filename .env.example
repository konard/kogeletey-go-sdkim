# =============================================================================
# Chat Application Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your environment

# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/chat_db
DB_LOGGING=false

# AWS S3 for Media Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_REGION=us-east-1
S3_BUCKET=chat-media
S3_ENDPOINT=                    # Optional: for MinIO or other S3-compatible storage
S3_URL_EXPIRATION=3600          # Presigned URL expiration in seconds

# WebSocket
WS_PORT=3000                    # Usually same as HTTP port
WS_PING_INTERVAL=25000          # Ping interval in ms
WS_PING_TIMEOUT=5000            # Ping timeout in ms
WS_CORS_ORIGIN=*                # CORS origin for WebSocket connections

# Logging
LOG_LEVEL=debug                 # debug, info, warn, error
